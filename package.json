{
  "name": "aangan-ecommerce",
  "version": "1.0.0",
  "description": "Aangan Luxury Clothing E-Commerce Website",
  "private": true,
  "scripts": {
    "dev": "node dev.js",
    "start": "node dev.js",
    "seed": "npm run seed --prefix backend",
    "dev:backend": "npm run start --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "build": "npm run build --prefix frontend && node -e \"require('fs').cpSync('frontend/dist', 'dist', {recursive: true})\""
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1"
  }
}
